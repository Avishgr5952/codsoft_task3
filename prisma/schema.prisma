generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum WorkMode {
  REMOTE
  HYBRID
  ON_SITE
}

enum ExperienceLevel {
  ENTRY_LEVEL
  MID_LEVEL
  SENIOR_LEVEL
  LEAD_EXECUTIVE
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  phone     String?
  role      Role       @default(CANDIDATE)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?
  savedJobs        SavedJob[]
  notifications    Notification[]

  @@map("users")
}

model CandidateProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline     String?
  bio          String?  @db.Text
  location     String?
  photoUrl     String?
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resumes      Resume[]
  educations   Education[]
  experiences  Experience[]
  skills       CandidateSkill[]
  applications Application[]

  @@map("candidate_profiles")
}

model Company {
  id          String   @id @default(uuid())
  name        String   @unique
  logoUrl     String?
  website     String?
  industry    String?
  location    String?
  companySize String?
  description String?  @db.Text
  foundedYear Int?
  linkedinUrl String?
  twitterUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recruiters RecruiterProfile[]
  jobs       Job[]

  @@map("companies")
}

model RecruiterProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  designation String?  @default("Talent Acquisition Lead")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs Job[]

  @@map("recruiter_profiles")
}

model JobCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())

  jobs Job[]

  @@map("job_categories")
}

model Job {
  id               String          @id @default(uuid())
  title            String
  description      String          @db.Text
  responsibilities String?         @db.Text
  requirements     String?         @db.Text
  benefits         String?         @db.Text
  skills           String[]
  jobType          JobType         @default(FULL_TIME)
  workMode         WorkMode        @default(HYBRID)
  experienceLevel  ExperienceLevel @default(MID_LEVEL)
  location         String
  salaryMin        Float?
  salaryMax        Float?
  salaryCurrency   String          @default("USD")
  deadline         DateTime?
  status           JobStatus       @default(ACTIVE)
  viewsCount       Int             @default(0)
  featured         Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiterId String?
  recruiter   RecruiterProfile? @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  categoryId  String
  category    JobCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  applications Application[]
  savedBy      SavedJob[]

  @@index([companyId])
  @@index([categoryId])
  @@index([status])
  @@index([jobType])
  @@index([workMode])
  @@index([location])
  @@map("jobs")
}

model Application {
  id                 String            @id @default(uuid())
  jobId              String
  job                Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfileId String
  candidateProfile   CandidateProfile  @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  resumeId           String?
  resume             Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  coverLetter        String?           @db.Text
  additionalInfo     String?           @db.Text
  status             ApplicationStatus @default(APPLIED)
  statusUpdatedAt    DateTime          @default(now())
  notes              String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  interviews Interview[]

  @@unique([jobId, candidateProfileId])
  @@index([jobId])
  @@index([candidateProfileId])
  @@index([status])
  @@map("applications")
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("saved_jobs")
}

model Resume {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  fileName           String
  fileUrl            String
  fileSize           Int
  fileType           String
  isDefault          Boolean          @default(false)
  uploadedAt         DateTime         @default(now())

  applications Application[]

  @@index([candidateProfileId])
  @@map("resumes")
}

model Skill {
  id       String  @id @default(uuid())
  name     String  @unique
  category String?

  candidateSkills CandidateSkill[]

  @@map("skills")
}

model CandidateSkill {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  skillId            String
  skill              Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  yearsOfExperience  Float?

  @@unique([candidateProfileId, skillId])
  @@index([candidateProfileId])
  @@index([skillId])
  @@map("candidate_skills")
}

model Education {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  institution        String
  degree             String
  fieldOfStudy       String?
  startDate          DateTime
  endDate            DateTime?
  grade              String?
  createdAt          DateTime         @default(now())

  @@index([candidateProfileId])
  @@map("education")
}

model Experience {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  company            String
  title              String
  location           String?
  startDate          DateTime
  endDate            DateTime?
  current            Boolean          @default(false)
  description        String?          @db.Text
  createdAt          DateTime         @default(now())

  @@index([candidateProfileId])
  @@map("experience")
}

model Interview {
  id             String      @id @default(uuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime
  locationOrLink String?
  interviewType  String      @default("Technical Interview")
  status         String      @default("SCHEDULED")
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([applicationId])
  @@map("interviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String   @default("SYSTEM")
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@map("notifications")
}
