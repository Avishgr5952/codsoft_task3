# CareerHub – Job Portal Environment Variables

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# If using the embedded PostgreSQL included with the project, leave defaults as:
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/careerhub?schema=public"
DIRECT_URL="postgresql://postgres:password@127.0.0.1:5432/careerhub?schema=public"

# JWT Secret for Session & Cookie Authentication
AUTH_SECRET="careerhub-production-jwt-secret-key-2026-secure"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Cloud Storage configuration (if migrating from local storage):
# CLOUDINARY_URL=
# AWS_S3_BUCKET=
# SUPABASE_URL=
